---
import type { Lang } from '@i18n/translations';
import { t } from '@i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const gallery = t(lang, 'gallery');

const photos = [
  { alt: 'Manzano Histórico', aspect: 'aspect-[4/3]' },
  { alt: 'Ascenso cordillerano', aspect: 'aspect-[3/4]' },
  { alt: 'Vista aérea del cruce', aspect: 'aspect-[4/3]' },
  { alt: 'Alta montaña', aspect: 'aspect-square' },
  { alt: 'Límite Argentina-Chile', aspect: 'aspect-[4/3]' },
  { alt: 'Paisaje andino', aspect: 'aspect-[3/4]' },
];
---

<section id="gallery" class="py-20 sm:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-mountain-600 font-display font-semibold text-sm tracking-[0.2em] uppercase mb-3">
        {gallery.subtitle}
      </p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-earth-950 mb-4">
        {gallery.title}
      </h2>
      <p class="text-earth-600 max-w-2xl mx-auto text-lg">
        {gallery.description}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {photos.map((photo, i) => (
        <div class={`relative group overflow-hidden rounded-2xl ${photo.aspect} bg-earth-200`}>
          <!-- REPLACE WITH YOUR IMAGES: -->
          <!-- <img src={`/assets/gallery-${i + 1}.jpg`} alt={photo.alt} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" /> -->
          
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center p-4">
              <svg class="w-12 h-12 text-earth-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-earth-500 text-sm font-medium">{photo.alt}</p>
              <p class="text-earth-400 text-xs mt-1">gallery-{i + 1}.jpg</p>
            </div>
          </div>

          <div class="absolute inset-0 bg-mountain-950/0 group-hover:bg-mountain-950/20 transition-all duration-300"></div>
        </div>
      ))}
    </div>

    <!-- Video section -->
    <div class="mt-12 sm:mt-16 rounded-2xl overflow-hidden bg-earth-100 aspect-video relative group">
      <!-- REPLACE WITH YOUR DRONE VIDEO: -->
      <!-- 
      <video controls class="absolute inset-0 w-full h-full object-cover" preload="metadata">
        <source src="/assets/drone-video.mp4" type="video/mp4" />
      </video> 
      -->
      
      <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
        <div class="w-20 h-20 rounded-full bg-mountain-500/20 flex items-center justify-center mb-4 group-hover:bg-mountain-500/30 transition-colors">
          <svg class="w-10 h-10 text-mountain-600 ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-xl text-earth-950 mb-2">{gallery.videoTitle}</h3>
        <p class="text-earth-500 text-sm">{gallery.videoDescription}</p>
        <p class="text-earth-400 text-xs mt-2">{gallery.videoPlaceholder}</p>
      </div>
    </div>
  </div>
</section>
