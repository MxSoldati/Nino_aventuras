---
import type { Lang } from '@i18n/translations';
import { t } from '@i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const itinerary = t(lang, 'itinerary');
---

<section id="itinerary" class="py-20 sm:py-28 bg-earth-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-mountain-600 font-display font-semibold text-sm tracking-[0.2em] uppercase mb-3">
        {itinerary.subtitle}
      </p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-earth-950 mb-4">
        {itinerary.title}
      </h2>
      <p class="text-earth-600 max-w-2xl mx-auto text-lg">
        {itinerary.description}
      </p>
    </div>

    <div id="itinerary-timeline" class="relative flex flex-col items-center">
      <!-- Timeline line -->
      <div class="absolute left-1/2 hidden h-full w-0.5 -translate-x-1/2 bg-mountain-300 md:block"></div>
      <div
        id="itinerary-line-fill"
        class="absolute left-1/2 hidden h-full w-0.5 -translate-x-1/2 origin-top scale-y-0 bg-gradient-to-b from-emerald-300 via-mountain-400 to-mountain-600 md:block"
      ></div>

      {itinerary.stages.map((stage, i) => (
        <div class="itinerary-stage flex flex-col md:grid md:grid-cols-[1fr_auto_1fr] md:items-center w-full mb-12 last:mb-0 items-center" data-stage-index={i}>
          <div class={`itinerary-card w-full rounded-3xl border border-transparent bg-white/65 backdrop-blur-sm mb-4 shadow-[0_18px_45px_rgba(16,24,40,0.04)] transition-all duration-500 ease-out md:bg-white/55 ${i % 2 === 0 ? 'md:col-start-1 md:justify-self-end md:text-right md:pr-8' : 'md:col-start-3 md:justify-self-start md:text-left md:pl-8'}`}>
            <div class="max-w-md rounded-3xl border border-earth-200/0 bg-transparent p-5 md:p-6 md:transition-all md:duration-500">
              <h3 class="font-display font-bold text-xl text-mountain-700 mb-2">
                {stage.title}
              </h3>
              <p class="text-earth-700 leading-relaxed">
                {stage.description}
              </p>
              <p class="text-earth-500 text-sm mt-2">
                {stage.detail} | {stage.distance}
              </p>
            </div>
          </div>

          <!-- Circle -->
          <div class="itinerary-node relative z-10 w-9 h-9 flex-shrink-0 rounded-full bg-gradient-to-br from-emerald-400 to-mountain-600 border-4 border-white flex items-center justify-center shadow-[0_0_0_0_rgba(16,185,129,0)] transition-all duration-500 md:col-start-2 md:row-start-1 md:justify-self-center" data-node-index={i}>
            <span class="text-white font-bold text-sm">{i + 1}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const timeline = document.querySelector('#itinerary-timeline');
    const lineFill = document.querySelector('#itinerary-line-fill');
    const stages = gsap.utils.toArray('.itinerary-stage');
    const nodes = gsap.utils.toArray('.itinerary-node');

    if (!timeline || !lineFill || !stages.length || !nodes.length) {
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion) {
      gsap.set(lineFill, { scaleY: 1 });
      gsap.set(stages, { opacity: 1, y: 0 });
      gsap.set(nodes, { scale: 1 });
      return;
    }

    gsap.set(stages, { opacity: 0.72, y: 18 });
    gsap.set(nodes, { scale: 1 });

    gsap.to(lineFill, {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: timeline,
        start: 'top 75%',
        end: 'bottom 25%',
        scrub: 0.8,
      },
    });

    gsap.to(lineFill, {
      opacity: 1,
      filter: 'drop-shadow(0 0 10px rgba(16,185,129,0.35)) drop-shadow(0 0 20px rgba(16,185,129,0.18))',
      ease: 'none',
      scrollTrigger: {
        trigger: timeline,
        start: 'top 85%',
        end: 'bottom 15%',
        scrub: 1,
      },
    });

    stages.forEach((stage, index) => {
      const node = nodes[index];

      ScrollTrigger.create({
        trigger: stage,
        start: 'top 60%',
        end: 'bottom 40%',
        onEnter: () => {
          gsap.to(stage, { opacity: 1, y: 0, scale: 1.02, duration: 0.45, ease: 'power2.out' });
          gsap.to(stage.querySelector('div'), {
            boxShadow: '0 20px 55px rgba(16,24,40,0.12)',
            borderColor: 'rgba(16,185,129,0.18)',
            duration: 0.35,
            ease: 'power2.out',
          });
          gsap.to(node, {
            scale: 1.3,
            boxShadow: '0 0 0 12px rgba(16,185,129,0.16), 0 0 34px rgba(16,185,129,0.28)',
            duration: 0.35,
            ease: 'power2.out',
          });
        },
        onEnterBack: () => {
          gsap.to(stage, { opacity: 1, y: 0, scale: 1.02, duration: 0.45, ease: 'power2.out' });
          gsap.to(stage.querySelector('div'), {
            boxShadow: '0 20px 55px rgba(16,24,40,0.12)',
            borderColor: 'rgba(16,185,129,0.18)',
            duration: 0.35,
            ease: 'power2.out',
          });
          gsap.to(node, {
            scale: 1.3,
            boxShadow: '0 0 0 12px rgba(16,185,129,0.16), 0 0 34px rgba(16,185,129,0.28)',
            duration: 0.35,
            ease: 'power2.out',
          });
        },
        onLeave: () => {
          gsap.to(stage, { opacity: 0.82, y: -6, scale: 0.995, duration: 0.28, ease: 'power2.out' });
          gsap.to(stage.querySelector('div'), {
            boxShadow: '0 18px 45px rgba(16,24,40,0.04)',
            borderColor: 'rgba(16,185,129,0)',
            duration: 0.28,
            ease: 'power2.out',
          });
          gsap.to(node, { scale: 1, boxShadow: '0 0 0 0 rgba(16,185,129,0)', duration: 0.28, ease: 'power2.out' });
        },
        onLeaveBack: () => {
          gsap.to(stage, { opacity: 0.72, y: 18, scale: 1, duration: 0.28, ease: 'power2.out' });
          gsap.to(stage.querySelector('div'), {
            boxShadow: '0 18px 45px rgba(16,24,40,0.04)',
            borderColor: 'rgba(16,185,129,0)',
            duration: 0.28,
            ease: 'power2.out',
          });
          gsap.to(node, { scale: 1, boxShadow: '0 0 0 0 rgba(16,185,129,0)', duration: 0.28, ease: 'power2.out' });
        },
      });
    });
  });
</script>

<style>
  .itinerary-stage {
    will-change: transform, opacity;
  }

  .itinerary-card {
    will-change: transform, box-shadow, border-color;
  }

  .itinerary-node {
    will-change: transform, box-shadow;
  }
</style>
