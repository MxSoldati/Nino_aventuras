---
import type { Lang } from '@i18n/translations';
import { t } from '@i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const itinerary = t(lang, 'itinerary');
---

<section id="itinerary" class="py-20 sm:py-28 bg-earth-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-mountain-600 font-display font-semibold text-sm tracking-[0.2em] uppercase mb-3">
        {itinerary.subtitle}
      </p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-earth-950 mb-4">
        {itinerary.title}
      </h2>
      <p class="text-earth-600 max-w-2xl mx-auto text-lg">
        {itinerary.description}
      </p>
    </div>

    <div class="relative flex flex-col items-center">
      <!-- Timeline line -->
      <div class="absolute w-0.5 bg-mountain-300 h-full left-1/2 -translate-x-1/2 hidden md:block"></div>

      {itinerary.stages.map((stage, i) => (
        <div class="flex flex-col md:grid md:grid-cols-[1fr_auto_1fr] md:items-center w-full mb-12 last:mb-0 items-center">
          <div class={`w-full mb-4 md:mb-0 ${i % 2 === 0 ? 'md:col-start-1 md:justify-self-end md:text-right md:pr-8' : 'md:col-start-3 md:justify-self-start md:text-left md:pl-8'}`}>
            <div class="max-w-md">
              <h3 class="font-display font-bold text-xl text-mountain-700 mb-2">
                {stage.title}
              </h3>
              <p class="text-earth-700 leading-relaxed">
                {stage.description}
              </p>
              <p class="text-earth-500 text-sm mt-2">
                {stage.detail} | {stage.distance}
              </p>
            </div>
          </div>

          <!-- Circle -->
          <div class="relative z-10 w-8 h-8 flex-shrink-0 rounded-full bg-mountain-500 border-4 border-white flex items-center justify-center md:col-start-2 md:row-start-1 md:justify-self-center">
            <span class="text-white font-bold text-sm">{i + 1}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
