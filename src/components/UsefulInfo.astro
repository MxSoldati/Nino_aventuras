---
import type { Lang } from '@i18n/translations';
import { t } from '@i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const info = t(lang, 'info');
---

<section id="info" class="py-20 sm:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-mountain-600 font-display font-semibold text-sm tracking-[0.2em] uppercase mb-3">
        {info.subtitle}
      </p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-earth-950 mb-4">
        {info.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Qué llevar -->
      <div class="bg-earth-50 p-8 rounded-2xl shadow-sm border border-earth-100">
        <h3 class="font-display font-bold text-2xl text-mountain-700 mb-4">{info.whatToBring.title}</h3>
        <ul class="space-y-3 text-earth-700 leading-relaxed">
          {info.whatToBring.items.map((item) => (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-mountain-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Época recomendada -->
      <div class="bg-earth-50 p-8 rounded-2xl shadow-sm border border-earth-100">
        <h3 class="font-display font-bold text-2xl text-mountain-700 mb-4">{info.season.title}</h3>
        <p class="text-earth-700 leading-relaxed mb-4">{info.season.description}</p>
        <ul class="space-y-2 text-earth-700">
          <li class="flex items-center gap-3">
            <span class="px-3 py-1 bg-mountain-100 text-mountain-700 text-xs font-semibold rounded-full">{info.season.months.best}</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="px-3 py-1 bg-sky-100 text-sky-700 text-xs font-semibold rounded-full">{info.season.months.possible}</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="px-3 py-1 bg-earth-100 text-earth-700 text-xs font-semibold rounded-full">{info.season.months.notRecommended}</span>
          </li>
        </ul>
        <div class="mt-6 pt-6 border-t border-earth-200">
          <h4 class="font-display font-bold text-xl text-mountain-700 mb-2">{info.difficulty.title}</h4>
          <p class="text-earth-700 text-lg font-semibold">{info.difficulty.level}</p>
          <p class="text-earth-600 text-sm mt-1">{info.difficulty.description}</p>
        </div>
      </div>

      <!-- Calendario Aventurero -->
      <div class="bg-earth-50 p-8 rounded-2xl shadow-sm border border-earth-100 lg:col-span-1 md:col-span-2">
        <h3 class="font-display font-bold text-2xl text-mountain-700 mb-4">{info.calendar.title}</h3>
        <p class="text-earth-700 leading-relaxed mb-6">{info.calendar.description}</p>
        <ul class="space-y-4">
          {info.calendar.trips.map((trip) => (
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-mountain-500/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-mountain-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-earth-950">{trip.date}</p>
                <p class="text-earth-600 text-sm">{trip.description}</p>
                <span class={`text-xs font-medium px-2 py-0.5 rounded-full mt-1 inline-block ${trip.status === 'Disponible' || trip.status === 'Available' ? 'bg-sky-100 text-sky-700' : 'bg-earth-100 text-earth-700'}`}>
                  {trip.status}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
