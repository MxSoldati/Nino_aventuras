---
interface Props {
  videoSrc?: string;
  posterSrc?: string;
}

const { videoSrc, posterSrc = '/assets/hero-background.jpg' } = Astro.props as Props;
---

<section class="scroll-container relative h-[460vh] overflow-hidden bg-[#070b0f] text-white">
  <div class="sticky top-0 h-screen w-full overflow-hidden">
    <div id="scene" class="absolute inset-0">
      {videoSrc ? (
        <video
          id="scene-video"
          class="absolute inset-0 h-full w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterSrc}
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : (
        <div
          class="absolute inset-0 bg-cover bg-center"
          style={`background-image: url('${posterSrc}');`}
        ></div>
      )}

      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.15),transparent_45%),linear-gradient(to_bottom,rgba(4,8,12,0.15),rgba(4,8,12,0.86))]"></div>

      <div class="absolute inset-0 opacity-50">
        <div class="mountain mountain-left"></div>
        <div class="mountain mountain-right"></div>
        <div class="mountain mountain-far"></div>
      </div>
    </div>

    <div class="relative z-20 flex h-full items-center justify-center px-4 sm:px-6">
      <div class="max-w-5xl text-center">
        <p id="scroll-kicker" class="mb-4 text-xs font-semibold uppercase tracking-[0.45em] text-amber-200/80">
          Scrollytelling del cruce
        </p>
        <h2 id="story-title" class="font-bold text-4xl leading-tight sm:text-5xl md:text-7xl">
          El Cruce de los Andes
        </h2>
        <p id="story-text" class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-white/80 sm:text-xl opacity-0">
          Un recorrido que se despliega por capas: paisaje, movimiento y relato. Si luego me pasas un video, lo integro como fondo; mientras tanto, el caballo cruza la escena con el scroll.
        </p>
      </div>
    </div>

    <div class="absolute inset-x-0 bottom-0 z-10 h-44 bg-gradient-to-t from-[#05070a] via-[#05070a]/80 to-transparent"></div>

    <div class="absolute inset-x-0 bottom-14 z-30 px-4 sm:px-6">
      <div class="relative mx-auto h-24 max-w-6xl">
        <div class="absolute inset-x-0 bottom-6 h-px bg-white/20"></div>
        <div class="absolute left-0 bottom-[22px] text-[10px] uppercase tracking-[0.4em] text-white/45">
          salida
        </div>
        <div class="absolute right-0 bottom-[22px] text-[10px] uppercase tracking-[0.4em] text-white/45">
          límite
        </div>

        <div id="horse-track" class="absolute inset-x-0 bottom-0 h-24">
          <div id="horse" class="horse absolute bottom-0 left-0">
            <svg viewBox="0 0 240 120" class="h-20 w-auto drop-shadow-[0_14px_26px_rgba(0,0,0,0.55)]" aria-hidden="true">
              <path fill="currentColor" d="M52 74c7-20 24-34 46-34h18l18-14c9-7 20-10 31-10h11c12 0 22 8 25 19l8 2c8 2 14 9 15 17l2 19 12 10c5 4 8 10 8 16v4c0 6-5 11-11 11H45c-9 0-16-7-16-16v-7c0-7 3-14 8-19l15-12zm40-7c0 7 6 13 13 13h9c3 0 5-2 5-5v-6c0-6-5-11-11-11h-6c-6 0-10 4-10 9zm61-31c-9 0-17 5-21 12l-7 14h35c9 0 16-7 16-16v-4c0-3-2-6-5-6h-18z" />
              <path fill="#24180f" d="M68 74h108c13 0 25 4 36 11l10 7H44c0-10 8-18 18-18h6z" opacity="0.85" />
              <path fill="#3b2a1c" d="M88 64c-5 0-9 4-9 9v11h18V72c0-5-4-8-9-8zm52-33c-6 0-11 3-14 8l-7 13h29c8 0 14-6 14-14v-4c0-2-2-3-3-3h-19z" opacity="0.95" />
              <circle cx="126" cy="30" r="7" fill="#1a120b" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute inset-x-0 top-8 z-30 flex justify-center px-4">
      <div class="panel inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/8 px-4 py-2 text-xs tracking-[0.28em] text-white/70 backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-emerald-300 shadow-[0_0_18px_rgba(110,231,183,0.9)]"></span>
        scrollytelling
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.scroll-container');
    const horse = document.querySelector('#horse');
    const storyText = document.querySelector('#story-text');
    const storyTitle = document.querySelector('#story-title');
    const scene = document.querySelector('#scene');
    const sceneVideo = document.querySelector('#scene-video');

    if (!container || !horse || !storyText || !storyTitle || !scene) {
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (sceneVideo) {
      sceneVideo.playbackRate = 0.9;
    }

    if (reducedMotion) {
      gsap.set(storyText, { opacity: 1 });
      gsap.set(horse, { xPercent: 0 });
      return;
    }

    const timeline = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1,
      },
    });

    timeline
      .to(scene, { scale: 1.08, filter: 'contrast(1.05) saturate(1.08)', ease: 'none' }, 0)
      .fromTo(storyText, { opacity: 0, y: 40 }, { opacity: 1, y: 0, ease: 'none' }, 0.18)
      .fromTo(horse, { x: '-12vw' }, { x: '92vw', ease: 'none' }, 0)
      .to(storyTitle, { y: -16, scale: 0.98, opacity: 0.9, ease: 'none' }, 0.55)
      .to(storyText, { opacity: 0.92, y: -10, ease: 'none' }, 0.62)
      .to(storyText, { opacity: 1, ease: 'none' }, 0.86);

    ScrollTrigger.create({
      trigger: container,
      start: 'top top',
      end: 'bottom bottom',
      scrub: true,
      onUpdate: (self) => {
        const progress = self.progress;

        if (progress < 0.33) {
          storyText.textContent = 'La ruta se abre entre valles altos y luz fría. El caballo entra como una marca de escala dentro del paisaje.';
        } else if (progress < 0.66) {
          storyText.textContent = 'En el ascenso, el movimiento se vuelve más lento y la cordillera domina la escena.';
        } else {
          storyText.textContent = 'Al cruzar la frontera, el gesto final es simple: avanzar y dejar que el paisaje termine de contar la historia.';
        }
      },
    });
  });
</script>

<style>
  .scroll-container {
    scrollbar-width: none;
  }

  .mountain {
    position: absolute;
    bottom: -2px;
    width: 56vw;
    height: 48vh;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(18, 25, 35, 0.84));
    clip-path: polygon(0 100%, 16% 58%, 27% 66%, 42% 34%, 57% 62%, 71% 43%, 86% 64%, 100% 38%, 100% 100%);
    filter: blur(0.2px);
  }

  .mountain-left {
    left: -6vw;
    opacity: 0.42;
    transform: scale(1.12);
  }

  .mountain-right {
    right: -8vw;
    opacity: 0.28;
    transform: scaleX(-1) scale(1.04);
  }

  .mountain-far {
    left: 18vw;
    width: 70vw;
    height: 34vh;
    opacity: 0.18;
    transform: scale(0.9);
    clip-path: polygon(0 100%, 12% 62%, 24% 70%, 39% 46%, 52% 60%, 67% 39%, 80% 56%, 92% 38%, 100% 100%);
  }

  .horse {
    color: #d9c3a2;
    will-change: transform;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45));
  }

  .panel {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.32);
  }
</style>