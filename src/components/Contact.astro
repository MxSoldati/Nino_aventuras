---
import type { Lang } from '@i18n/translations';
import { t } from '@i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const contact = t(lang, 'contact');
---

<section id="contact" class="py-20 sm:py-28 bg-earth-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-sky-300 font-display font-semibold text-sm tracking-[0.2em] uppercase mb-3">
        {contact.subtitle}
      </p>
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-white mb-4">
        {contact.title}
      </h2>
      <p class="text-white/70 max-w-2xl mx-auto text-lg">
        {contact.description}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Formulario de Contacto -->
      <div class="bg-earth-800 p-8 rounded-2xl shadow-xl border border-earth-700">
        <form class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-white/90 mb-2">{contact.form.name}</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              placeholder={contact.form.namePlaceholder} 
              class="w-full px-5 py-3 bg-earth-700 border border-earth-600 rounded-lg text-white placeholder-earth-400 focus:outline-none focus:ring-2 focus:ring-mountain-500 focus:border-transparent transition-colors"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-white/90 mb-2">{contact.form.email}</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              placeholder={contact.form.emailPlaceholder} 
              class="w-full px-5 py-3 bg-earth-700 border border-earth-600 rounded-lg text-white placeholder-earth-400 focus:outline-none focus:ring-2 focus:ring-mountain-500 focus:border-transparent transition-colors"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-white/90 mb-2">{contact.form.message}</label>
            <textarea 
              id="message" 
              name="message" 
              rows={5} 
              placeholder={contact.form.messagePlaceholder} 
              class="w-full px-5 py-3 bg-earth-700 border border-earth-600 rounded-lg text-white placeholder-earth-400 focus:outline-none focus:ring-2 focus:ring-mountain-500 focus:border-transparent transition-colors"
            ></textarea>
          </div>
          <button 
            type="submit" 
            class="w-full px-8 py-4 bg-mountain-500 hover:bg-mountain-400 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-mountain-500/30 hover:shadow-mountain-400/40 hover:-translate-y-0.5 text-lg"
          >
            {contact.form.submit}
          </button>
        </form>
      </div>

      <!-- Datos de contacto y redes sociales -->
      <div class="bg-earth-800 p-8 rounded-2xl shadow-xl border border-earth-700">
        <h3 class="font-display font-bold text-2xl text-white mb-6">{contact.details.title}</h3>
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <svg class="w-7 h-7 text-mountain-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <p class="text-white/80">{contact.details.phone}</p>
              <p class="text-white font-semibold">+54 9 261 123-4567</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <svg class="w-7 h-7 text-mountain-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555zM0 4.697v7.104l5.803-3.55ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm7.366 2.38L16 11.801V4.697l-1.873 2.113Z" />
            </svg>
            <div>
              <p class="text-white/80">{contact.details.email}</p>
              <p class="text-white font-semibold">info@ninoaventuras.com</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <svg class="w-7 h-7 text-mountain-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
            <div>
              <p class="text-white/80">{contact.details.location}</p>
              <p class="text-white font-semibold">Mendoza, Argentina</p>
            </div>
          </div>
        </div>
        
        <div class="mt-10 border-t border-earth-700 pt-8">
          <h4 class="font-display font-bold text-xl text-white mb-4">{contact.details.social}</h4>
          <div class="flex gap-4">
            <a href="#" class="text-white/70 hover:text-white transition-colors">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M22.258 1H2.242C1.556 1 1 1.556 1 2.242v19.516C1 22.444 1.556 23 2.242 23h19.516c.686 0 1.242-.556 1.242-1.242V2.242C23 1.556 22.444 1 22.258 1zM7 19H4V8h3v11zm-1.5-12h-.025C3.722 7 3 6.277 3 5.5S3.722 4 4.5 4c.777 0 1.5.723 1.5 1.5S5.277 7 4.5 7zM20 19h-4v-5.604c0-3.368-4-3.13-4 0V19H9V8h3v1.733c.96-.943 2.29-1.733 4-1.733 4.418 0 5 3.03 5 6.042V19z"/></svg>
            </a>
            <a href="#" class="text-white/70 hover:text-white transition-colors">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07c3.252.148 4.771 1.691 4.919 4.919.058 1.265.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.646.07-4.85.07s-3.585-.012-4.85-.07c-3.254-.148-4.773-1.691-4.92-4.919-.058-1.265-.07-1.646-.07-4.85s.012-3.585.07-4.85c.149-3.227 1.664-4.773 4.92-4.92 1.265-.058 1.646-.07 4.85-.07zm0 2.163c-3.238 0-3.627.016-4.896.076-2.433.111-3.717 1.401-3.829 3.829-.06.269-.074.358-.074.394v.055c0 3.238.016 3.627.076 4.896.111 2.433 1.401 3.717 3.829 3.829.269.06.358.074.394.074h.055c3.238 0 3.627-.016 4.896-.076 2.433-.111 3.717-1.401 3.829-3.829.06-.269.074-.358.074-.394v-.055c0-3.238-.016-3.627-.076-4.896-.111-2.433-1.401-3.717-3.829-3.829-.269-.06-.358-.074-.394-.074h-.055zm0 1.936c-2.481 0-4.492 2.011-4.492 4.492s2.011 4.492 4.492 4.492 4.492-2.011 4.492-4.492-2.011-4.492-4.492-4.492zm0 2.163c1.298 0 2.329 1.031 2.329 2.329s-1.031 2.329-2.329 2.329-2.329-1.031-2.329-2.329 1.031-2.329 2.329-2.329zm5.28-4.442c-.672 0-1.218.546-1.218 1.218s.546 1.218 1.218 1.218c.672 0 1.218-.546 1.218-1.218s-.546-1.218-1.218-1.218z"/></svg>
            </a>
            <a href="#" class="text-white/70 hover:text-white transition-colors">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M2.008 21.082l1.52-4.996C2.69 14.868 2 13.064 2 11.139c0-5.262 4.195-9.516 9.378-9.516 2.583 0 5.035 1.032 6.845 2.872s2.898 4.218 2.898 6.783c0 5.262-4.196 9.516-9.379 9.516H2.008zm15.71-8.113c-.097-.071-.24-.108-.428-.108-.224 0-.414.071-.563.212-.134.137-.202.32-.202.548 0 .229.07.41.209.548.14.136.326.205.559.205.187 0 .33-.037.428-.108.097-.07.145-.164.145-.278 0-.114-.048-.208-.145-.278zm-3.528 2.222c-.097-.07-.24-.107-.428-.107-.224 0-.414.07-.563.211-.134.137-.202.319-.202.547 0 .23.07.41.209.549.14.136.326.205.559.205.187 0 .33-.037.428-.108.097-.07.145-.164.145-.278 0-.114-.048-.208-.145-.278zm-3.528 2.222c-.097-.071-.24-.108-.428-.108-.224 0-.414.071-.563.212-.134.137-.202.32-.202.548 0 .229.07.41.209.548.14.136.326.205.559.205.187 0 .33-.037.428-.108.097-.07.145-.164.145-.278 0-.114-.048-.208-.145-.278z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
