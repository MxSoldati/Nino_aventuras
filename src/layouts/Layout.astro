---
import type { Lang } from '@i18n/translations';
import { t } from '@i18n/translations';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const nav = t(lang, 'nav');
const footer = t(lang, 'footer');
const langSwitch = t(lang, 'langSwitch');
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Nino Aventuras - Cruce de los Andes desde el Manzano Histórico hasta el límite Argentina-Chile" />
  <title>{title} | Nino Aventuras</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="font-body bg-earth-50 text-earth-950 antialiased">
  <header class="fixed top-0 left-0 right-0 z-50 bg-mountain-950/90 backdrop-blur-sm border-b border-white/10">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href={`/${lang === 'en' ? 'en/' : ''}`} class="font-display font-bold text-xl text-white tracking-wide">
        {nav.logo}
      </a>
      
      <div class="hidden md:flex items-center gap-6">
        <a href="#gallery" class="text-white/80 hover:text-white transition-colors text-sm font-medium">{nav.gallery}</a>
        <a href="#itinerary" class="text-white/80 hover:text-white transition-colors text-sm font-medium">{nav.itinerary}</a>
        <a href="#info" class="text-white/80 hover:text-white transition-colors text-sm font-medium">{nav.info}</a>
        <a href="#contact" class="text-white/80 hover:text-white transition-colors text-sm font-medium">{nav.contact}</a>
      </div>

      <a 
        href={lang === 'es' ? '/en/' : '/'}
        class="px-3 py-1.5 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-semibold transition-colors border border-white/20"
      >
        {lang === 'es' ? langSwitch.en : langSwitch.es}
      </a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-mountain-950 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-center md:text-left">
          <h3 class="font-display font-bold text-lg">{nav.logo}</h3>
          <p class="text-white/60 text-sm mt-1">{footer.tagline}</p>
        </div>
        <p class="text-white/40 text-sm">{footer.rights}</p>
      </div>
    </div>
  </footer>

  <style>
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 4rem;
    }
  </style>
</body>
</html>
