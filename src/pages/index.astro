---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import Gallery from '@components/Gallery.astro';
import Itinerary from '@components/Itinerary.astro';
import UsefulInfo from '@components/UsefulInfo.astro';
import Contact from '@components/Contact.astro';
import CruceScroll from '@components/CruceScroll.astro';

const lang = 'es';
---

<Layout lang={lang} title="Cruce de los Andes">
  <Hero lang={lang} />
  <CruceScroll />
  <Gallery lang={lang} />
  <Itinerary lang={lang} />
  <UsefulInfo lang={lang} />
  <Contact lang={lang} />
</Layout>
